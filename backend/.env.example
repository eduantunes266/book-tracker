# Copy this file to .env and fill in your own values.

# Port where the Express server listens
PORT=5000

# MongoDB Atlas connection string (development mode only;
# with Docker Compose the local mongo container is used instead)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/shelflog?retryWrites=true&w=majority

# REQUIRED: secret used to sign JWT tokens (use a long random string,
# see "Getting Started" in the README for a command that generates one)
JWT_SECRET=<your-jwt-secret>
